// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "YourAppID",
  "asar": true,
  "productName": "FlowSonat",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "publish": [
    {
      "provider": "generic",
      "url": "https://d3hlgb8urc94dl.cloudfront.net",
      "channel": "latest"
    }
  ],
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}-Mac-${arch}-${version}.${ext}",
    "icon": "build/icon.png",
    "category": "public.app-category.productivity",
    "identity": "milylog Inc. (BJ8U9646U7)",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": {
      "teamId": "BJ8U9646U7"
    },
    "extendInfo": {
      "NSAppleEventsUsageDescription": "This app needs to control other applications to provide automation features.",
      "NSCameraUsageDescription": "This app needs access to camera for media features.",
      "NSMicrophoneUsageDescription": "This app needs access to microphone for audio features."
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64", "ia32"]
      }
    ],
    "artifactName": "${productName}-Windows-${arch}-${version}.${ext}",
    "icon": "build/icon.ico",
    "certificateFile": "build/certificates/flowsonat-windows-cert.p12",
    "certificatePassword": "flowsonat123",
    "signAndEditExecutable": true,
    "signDlls": true,
    "publisherName": "FlowSonat"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "armv7l", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "armv7l", "arm64"]
      }
    ],
    "artifactName": "${productName}-Linux-${arch}-${version}.${ext}",
    "icon": "build/icon.png"
  }
}
